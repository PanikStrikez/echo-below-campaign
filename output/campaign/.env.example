# Optional local server environment. Copy to .env locally; never share credentials.
# Load it in a shell before starting launchers/serve_campaign.py.

# Defaults to ~/.echo-below-campaign, outside the served application tree.
# ECHO_CAMPAIGN_STATE_DIR=/absolute/private/path/echo-campaign

# Optional if the launcher Python has no pypdf / pdftotext.
# The installed Codex bundled Python is detected automatically when available.
# ECHO_PDF_PYTHON=/absolute/path/to/python3
# Image-only PDFs use local macOS Vision OCR and a source-hash cache by default.
# Set to 0 to disable OCR; image-only sources will be reported as unindexed.
# ECHO_SOURCE_OCR=1

# Optional: existing AI settings control provider, consent and budget.
# OPENAI_API_KEY=
# Existing ChatGPT sign-in also works through Settings > AI assistance.

# Existing ElevenLabs private key setup also works; never put a key in browser code.
# ELEVENLABS_API_KEY=
# Choose stock voices from the app's existing ElevenLabs voice catalog.
ELEVENLABS_VOICE_DURNAN=
ELEVENLABS_VOICE_GUNDREN=
ELEVENLABS_VOICE_SELISE=
ELEVENLABS_VOICE_HALASTER=
